{
  "name": "luma-pole-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run build && npm run preview",
    "test": "node --test tests/*.test.js",
    "build:poste": "vite build && node scripts/build-pole.mjs",
    "instalar:poste": "node scripts/install-on-pole.mjs",
    "test:e2e": "vite build && node --test --test-concurrency=1 tests/e2e/app.e2e.mjs",
    "capturas:manual": "vite build && node scripts/capturas-manual.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,mjs}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"tests/**/*.{js,mjs}\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "playwright-core": "1.59",
    "prettier": "3.6.2",
    "vite": "^7.3.1"
  }
}
